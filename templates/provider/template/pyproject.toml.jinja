[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.13"
dependencies = [
    "pragmatiks-sdk>=14.0.0",
]
{% if author_name or author_email %}
authors = [
    { name = "{{ author_name }}"{% if author_email %}, email = "{{ author_email }}"{% endif %} },
]
{% endif %}

[dependency-groups]
dev = [
    "ruff==0.16.8",
    "ty==0.0.63",
]

[tool.pragma]
# Provider metadata - used by the platform for discovery and deployment
provider = "{{ name }}"
package = "{{ package_name }}"
display_name = "{{ display_name }}"
description = "{{ description }}"
tags = []

[tool.ruff]
line-length = 120

[build-system]
requires = ["uv_build>=0.9.8,<0.10.0"]
build-backend = "uv_build"
